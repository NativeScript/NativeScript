{
  "name": "@nativescript/compiler",
  "version": "9.2.0-alpha.0",
  "description": "Compiles a NativeScript app written with Vue, Angular, Svelte, React, Solid or Octane into a native iOS or Android app with no JavaScript runtime.",
  "license": "Apache-2.0",
  "homepage": "https://docs.nativescript.org/guide/publishing/compiled",
  "repository": {
    "type": "git",
    "url": "https://github.com/NativeScript/NativeScript.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/NativeScript/NativeScript/issues"
  },
  "type": "module",
  "bin": {
    "ns-native": "bin/ns-native.js",
    "ns-native-retrace": "bin/ns-native-retrace.js",
    "ns-compiled-verify": "bin/ns-compiled-verify.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "runtime/",
    "verify/",
    "kit-apple/Package.swift",
    "kit-apple/Sources/",
    "kit-apple/Bindings/",
    "kit-android/build.gradle.kts",
    "kit-android/consumer-rules.pro",
    "kit-android/lint-generated-kit.xml",
    "kit-android/gradlew",
    "kit-android/gradle/",
    "kit-android/src/",
    "kit-android/generated/",
    "kit-android/Bindings/",
    "docs/CLI.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@angular/compiler": "^22.2.1",
    "@vue/compiler-sfc": "^3.5.0",
    "svelte": "^4.2.20",
    "typescript": "~5.9.0"
  },
  "peerDependencies": {
    "@nativescript/core": "9.2.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@nativescript/core": {
      "optional": true
    }
  },
  "nativescript": {
    "testedFrameworks": {
      "vue": {
        "nativescript-vue": ">=3.1.0 <4.0.0"
      },
      "angular": {
        "@nativescript/angular": ">=22.0.0 <23.0.0",
        "@angular/core": ">=22.0.0 <23.0.0"
      },
      "react": {
        "react-nativescript": ">=5.0.0 <6.0.0",
        "react": ">=18.2.0 <19.0.0"
      },
      "solid": {
        "@nativescript-community/solid-js": ">=2.0.0-rc.0 <3.0.0",
        "solid-js": ">=2.0.0-rc.0 <3.0.0"
      },
      "svelte": {
        "@nativescript-community/svelte-native": ">=1.0.0 <2.0.0 || >=5.0.0-alpha.0 <6.0.0",
        "svelte": ">=4.2.0 <5.0.0 || >=5.50.0 <6.0.0"
      },
      "octane": {
        "@nativescript-community/octane": ">=0.2.4 <0.3.0"
      }
    }
  },
  "scripts": {
    "prepack": "node tests/kits-present.mjs && node bin/build-dist.mjs",
    "postpack": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  }
}
