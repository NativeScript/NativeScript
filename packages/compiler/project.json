{
	"name": "compiler",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/compiler/src",
	"projectType": "library",
	"implicitDependencies": ["core"],
	"targets": {
		"deps": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["npm ci --no-audit --no-fund", "npm install --prefix tests --no-audit --no-fund"],
				"parallel": false,
				"cwd": "{projectRoot}"
			}
		},
		"kit": {
			"executor": "nx:run-commands",
			"dependsOn": ["deps", { "projects": ["core"], "target": "build" }],
			"inputs": ["{projectRoot}/src/**/*", "{workspaceRoot}/packages/core/**/*", "{workspaceRoot}/tools/native-kit/**/*"],
			"outputs": ["{projectRoot}/kit-apple/Sources/NativeScriptKit/Core"],
			"options": {
				"command": "node --stack-size=8000 tools/native-kit/generate.mts --partial",
				"cwd": "{workspaceRoot}"
			}
		},
		"kit-android": {
			"executor": "nx:run-commands",
			"dependsOn": ["deps", { "projects": ["core"], "target": "build" }],
			"inputs": ["{projectRoot}/src/**/*", "{workspaceRoot}/packages/core/**/*", "{workspaceRoot}/tools/native-kit/**/*"],
			"outputs": ["{projectRoot}/kit-android/generated"],
			"options": {
				"command": "node --stack-size=8000 tools/native-kit/generate-android.mts --partial",
				"cwd": "{workspaceRoot}",
				"forwardAllArgs": true
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"dependsOn": ["deps"],
			"options": {
				"command": "node tests/diff/run.ts",
				"cwd": "{projectRoot}",
				"forwardAllArgs": true
			}
		},
		"pack": {
			"executor": "nx:run-commands",
			"dependsOn": ["kit"],
			"outputs": ["{workspaceRoot}/dist/packages"],
			"options": {
				"command": "mkdir -p ../../dist/packages && npm pack --pack-destination ../../dist/packages",
				"cwd": "{projectRoot}"
			}
		}
	}
}
