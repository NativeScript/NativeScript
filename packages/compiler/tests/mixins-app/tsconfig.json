{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "ESNext"],
    "sourceMap": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./app/*"]
    },
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  },
  "include": ["app", "types"],
  "exclude": ["node_modules", "platforms"]
}
