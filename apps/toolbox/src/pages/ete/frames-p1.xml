<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" actionBarHidden="true" backgroundColor="#1d4ed8">
  <GridLayout rows="auto, auto, *, auto">
    <StackLayout row="0" padding="12">
      <Label text="page 1 - no scroll" color="#ffffff" fontWeight="bold" fontSize="16" />
      <Label text="static content; wants to end above the bar" color="#bfdbfe" fontSize="13" textWrap="true" />
    </StackLayout>
    <GridLayout row="1" columns="*, *, *, *" padding="6">
      <Button col="0" text="p1" tap="{{ go1 }}" color="#ffffff" backgroundColor="#1e40af" />
      <Button col="1" text="p2" tap="{{ go2 }}" color="#ffffff" backgroundColor="#1e40af" />
      <Button col="2" text="p3" tap="{{ go3 }}" color="#ffffff" backgroundColor="#1e40af" />
      <Button col="3" text="exit" tap="{{ back }}" color="#ffffff" backgroundColor="#1e40af" />
    </GridLayout>
    <StackLayout row="2" padding="12">
      <Label text="{{ numbers }}" color="#bfdbfe" fontFamily="monospace" fontSize="13" textWrap="true" />
      <Label text="{{ verdict }}" color="#fde68a" fontWeight="bold" fontSize="15" textWrap="true" marginTop="8" />
    </StackLayout>
    <StackLayout row="3" id="marker" backgroundColor="#166534">
      <Label text="last content of page 1" color="#ffffff" fontSize="11" textAlignment="center" padding="4" />
      <StackLayout id="line-p1" height="4" backgroundColor="#b45309" />
    </StackLayout>
  </GridLayout>
</Page>
