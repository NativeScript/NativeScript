<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" actionBarHidden="true" androidOverflowEdge="ignore" backgroundColor="#3f0d12">
  <GridLayout rows="auto, auto, *, auto" backgroundColor="#1d4ed8">
    <StackLayout row="0" padding="12">
      <Label text="{{ heading }}" color="#ffffff" fontWeight="bold" fontSize="16" textWrap="true" fontFamily="monospace" />
      <Label text="{{ description }}" color="#bfdbfe" fontSize="13" textWrap="true" marginTop="4" />
    </StackLayout>

    <GridLayout row="1" columns="*, *, *" padding="8">
      <Button col="0" text="&lt; prev" tap="{{ prev }}" color="#ffffff" backgroundColor="#1e40af" />
      <Button col="1" text="next &gt;" tap="{{ next }}" color="#ffffff" backgroundColor="#1e40af" />
      <Button col="2" text="back" tap="{{ back }}" color="#ffffff" backgroundColor="#1e40af" />
    </GridLayout>

    <ScrollView row="2">
      <StackLayout padding="12">
        <Label text="SafeArea (l, t, r, b in dip)" color="#ffffff" fontWeight="bold" />
        <Label text="{{ insets }}" color="#bfdbfe" fontFamily="monospace" fontSize="13" textWrap="true" />
        <Label text="{{ maxInsets }}" color="#bfdbfe" fontFamily="monospace" fontSize="13" textWrap="true" />

        <Label text="what env() resolved to" color="#ffffff" fontWeight="bold" marginTop="10" />
        <Label text="{{ resolved }}" color="#bfdbfe" fontFamily="monospace" fontSize="13" textWrap="true" />

        <Label text="css, for comparison" color="#ffffff" fontWeight="bold" marginTop="10" />
        <Label text="the strip below is styled from the stylesheet rather than ts" color="#bfdbfe" fontSize="13" textWrap="true" />
        <StackLayout class="env-css-probe" backgroundColor="#166534" marginTop="6">
          <StackLayout height="4" backgroundColor="#b45309" />
        </StackLayout>

        <Label text="safe-area-padding: 6dip" color="#ffffff" fontWeight="bold" marginTop="10" />
        <Label text="padding plus whatever inset is left - mid-page nothing is left, so a plain 6dip ring" color="#bfdbfe" fontSize="13" textWrap="true" />
        <StackLayout class="env-shorthand-probe" backgroundColor="#166534" marginTop="6">
          <StackLayout height="4" backgroundColor="#b45309" />
        </StackLayout>

        <Label text="{{ hint }}" color="#fde68a" fontSize="13" textWrap="true" marginTop="12" />
      </StackLayout>
    </ScrollView>

    <!--
      Two probes side by side. The left one overflows the bottom explicitly, the right
      one asks the framework to inset every edge - but it pads the bottom from the
      safe area itself, which takes that edge over. The rings should match; a thicker
      right ring is double padding.
    -->
    <GridLayout row="3" columns="*, *">
      <StackLayout col="0" id="probe" backgroundColor="#166534" overflowSafeArea="bottom">
        <Label text="overflowSafeArea=bottom" color="#ffffff" fontSize="11" textAlignment="center" padding="6" />
      </StackLayout>
      <StackLayout col="1" id="twin" backgroundColor="#166534" overflowSafeArea="none">
        <Label text="overflowSafeArea=none" color="#ffffff" fontSize="11" textAlignment="center" padding="6" />
      </StackLayout>
    </GridLayout>
  </GridLayout>
</Page>
