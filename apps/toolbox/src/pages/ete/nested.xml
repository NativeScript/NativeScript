<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" actionBarHidden="true" androidOverflowEdge="ignore" backgroundColor="#3f0d12">
  <!-- outer takes the insets into JS and pads nothing; inner pads by whatever outer left behind. -->
  <GridLayout id="outer" backgroundColor="#166534" androidOverflowEdge="dont-apply">
    <GridLayout id="inner" backgroundColor="#1d4ed8" androidOverflowEdge="none">
      <GridLayout backgroundColor="#b45309" rows="auto, *, auto">
        <StackLayout row="0" padding="12">
          <Label text="Nested consume" color="#ffffff" fontWeight="bold" fontSize="17" />
          <Label text="The blue ring is what outer did NOT consume. Consuming an edge in JS must shrink that side of the ring to nothing." color="#fed7aa" fontSize="13" textWrap="true" />
        </StackLayout>

        <ScrollView row="1">
          <StackLayout padding="12">
            <Label text="{{ raw }}" color="#ffffff" fontFamily="monospace" fontSize="13" textWrap="true" />
            <Label text="{{ consuming }}" color="#ffffff" fontFamily="monospace" fontSize="13" textWrap="true" marginTop="6" />
            <Label text="{{ topOverride }}" color="#ffffff" fontFamily="monospace" fontSize="13" textWrap="true" marginTop="6" />
            <Label text="inner padding (= what survived)" color="#ffffff" fontWeight="bold" marginTop="10" />
            <Label text="{{ innerPadding }}" color="#fed7aa" fontFamily="monospace" fontSize="13" textWrap="true" />
            <Label text="outer padding (must stay at 0 - dont-apply)" color="#ffffff" fontWeight="bold" marginTop="10" />
            <Label text="{{ outerPadding }}" color="#fed7aa" fontFamily="monospace" fontSize="13" textWrap="true" />
            <Label text="{{ verdict }}" color="#fde68a" fontSize="14" fontWeight="bold" textWrap="true" marginTop="12" />
          </StackLayout>
        </ScrollView>

        <StackLayout row="2" padding="8">
          <GridLayout columns="*, *, *, *">
            <Button col="0" text="top" tap="{{ toggleTop }}" color="#ffffff" backgroundColor="#7c2d12" />
            <Button col="1" text="bottom" tap="{{ toggleBottom }}" color="#ffffff" backgroundColor="#7c2d12" />
            <Button col="2" text="left" tap="{{ toggleLeft }}" color="#ffffff" backgroundColor="#7c2d12" />
            <Button col="3" text="right" tap="{{ toggleRight }}" color="#ffffff" backgroundColor="#7c2d12" />
          </GridLayout>
          <GridLayout columns="*, *" marginTop="4">
            <Button col="0" text="top = 200px" tap="{{ toggleOverride }}" color="#ffffff" backgroundColor="#7c2d12" />
            <Button col="1" text="back" tap="{{ back }}" color="#ffffff" backgroundColor="#7c2d12" />
          </GridLayout>
        </StackLayout>
      </GridLayout>
    </GridLayout>
  </GridLayout>
</Page>
