<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" navigatingFrom="navigatingFrom" class="page">
    <Page.actionBar>
        <ActionBar title="Multiple Windows Demo" class="action-bar">
        </ActionBar>
    </Page.actionBar>

    <ScrollView>
        <StackLayout class="p-20">

            <!-- Capability status -->
            <StackLayout class="card p-20 m-b-20">
                <Label text="Multi-window support" class="h3 text-center m-b-15"/>
                <Label text="{{ statusText }}" class="body text-center m-b-10" textWrap="true"/>
                <Label text="{{ capabilityNote }}" class="caption text-center m-b-15" textWrap="true"
                       visibility="{{ capabilityNote ? 'visible' : 'collapsed' }}"/>

                <GridLayout columns="*, auto" class="m-t-10">
                    <Label col="0" text="Open windows:" class="body"/>
                    <Label col="1" text="{{ windowCount }}" class="body font-weight-bold"/>
                </GridLayout>

                <GridLayout columns="*, *" class="m-t-15">
                    <Button col="0" text="Refresh" tap="{{ onRefresh }}" class="btn btn-outline m-r-10"/>
                    <Button col="1" text="Window details" tap="{{ onShowDetails }}" class="btn btn-outline m-l-10"/>
                </GridLayout>
            </StackLayout>

            <!-- Window controls -->
            <StackLayout class="card p-20 m-b-20" visibility="{{ canOpenWindows ? 'visible' : 'collapsed' }}">
                <Label text="Open a window" class="h3 text-center m-b-15"/>
                <Label text="Each button calls Application.openWindow() with a different payload. The window content resolver reads that payload and builds the matching UI."
                       class="caption text-center m-b-15" textWrap="true"/>

                <GridLayout columns="*, *" class="m-t-10">
                    <Button col="0" text="Basic window" tap="{{ onOpenBasicWindow }}" class="btn btn-primary m-r-10"/>
                    <Button col="1" text="Alternate window" tap="{{ onOpenAltWindow }}" class="btn btn-primary m-l-10"/>
                </GridLayout>
            </StackLayout>

            <!-- Live window list -->
            <StackLayout class="card p-20 m-b-20">
                <Label text="Windows" class="h3 text-center m-b-15"/>
                <Label text="Updated live from the per-window lifecycle and trait events."
                       class="caption text-center m-b-15" textWrap="true"/>

                <Repeater items="{{ windows }}">
                    <Repeater.itemTemplate>
                        <StackLayout class="event-item p-10 m-b-10">
                            <Label text="{{ summary }}" class="body font-weight-bold" textWrap="true"/>
                            <Label text="{{ traits }}" class="caption" textWrap="true"/>
                            <Label text="{{ native }}" class="caption" textWrap="true"/>
                            <Button text="Close window" tap="{{ requestClose }}" class="btn btn-outline m-t-10"
                                    visibility="{{ canClose ? 'visible' : 'collapsed' }}"/>
                        </StackLayout>
                    </Repeater.itemTemplate>
                </Repeater>
            </StackLayout>

            <!-- iOS scene setup help -->
            <StackLayout class="card p-20 m-b-20" visibility="{{ showIosSceneSetup ? 'visible' : 'collapsed' }}">
                <Label text="Enable the iOS scene lifecycle" class="h3 text-center m-b-15"/>
                <Label text="Add this to App_Resources/iOS/Info.plist and rebuild:"
                       class="body m-b-10" textWrap="true"/>

                <Label class="code-block m-b-15" textWrap="true">
                    <Span text="&lt;key&gt;UIApplicationSceneManifest&lt;/key&gt;&#10;"/>
                    <Span text="&lt;dict&gt;&#10;"/>
                    <Span text="    &lt;key&gt;UIApplicationPreferredDefaultSceneSessionRole&lt;/key&gt;&#10;"/>
                    <Span text="    &lt;string&gt;UIWindowSceneSessionRoleApplication&lt;/string&gt;&#10;"/>
                    <Span text="    &lt;key&gt;UIApplicationSupportsMultipleScenes&lt;/key&gt;&#10;"/>
                    <Span text="    &lt;true/&gt;&#10;"/>
                    <Span text="&lt;/dict&gt;"/>
                </Label>

                <Label text="Core registers its own scene delegate, so no UISceneDelegateClassName entry is needed."
                       class="caption" textWrap="true"/>
            </StackLayout>

            <!-- Event log -->
            <StackLayout class="card p-20 m-b-20">
                <GridLayout columns="*, auto" class="m-b-15">
                    <Label col="0" text="Window events" class="h3"/>
                    <Button col="1" text="Clear" tap="{{ onClearEvents }}" class="btn btn-outline"/>
                </GridLayout>

                <ScrollView height="250" class="border">
                    <StackLayout class="p-10">
                        <Label visibility="{{ events.length === 0 ? 'visible' : 'collapsed' }}"
                               text="No events yet. Open a window, rotate the device, or switch between light and dark mode."
                               class="caption text-center" textWrap="true"/>

                        <Repeater items="{{ events }}">
                            <Repeater.itemTemplate>
                                <StackLayout class="event-item p-5">
                                    <Label text="{{ $value }}" class="caption" textWrap="true"/>
                                </StackLayout>
                            </Repeater.itemTemplate>
                        </Repeater>
                    </StackLayout>
                </ScrollView>
            </StackLayout>

            <!-- How to test -->
            <StackLayout class="card p-20 m-b-20">
                <Label text="How to test" class="h3 text-center m-b-15"/>

                <StackLayout class="m-b-10">
                    <Label text="iOS" class="body font-weight-bold"/>
                    <Label text="• An iPad (or Stage Manager) is needed for a second scene; iPhone reports a single scene." class="caption m-l-15" textWrap="true"/>
                    <Label text="• Drag the new window out of the app switcher to place it side by side." class="caption m-l-15" textWrap="true"/>
                </StackLayout>

                <StackLayout class="m-b-10">
                    <Label text="Android" class="body font-weight-bold"/>
                    <Label text="• Windows are activities in their own task, so results depend on launchMode and the device's recents behaviour." class="caption m-l-15" textWrap="true"/>
                    <Label text="• Use split screen, a foldable, or desktop mode to see two at once." class="caption m-l-15" textWrap="true"/>
                </StackLayout>

                <StackLayout>
                    <Label text="Both" class="body font-weight-bold"/>
                    <Label text="• Rotate one window or switch the system theme: only that window's row changes." class="caption m-l-15" textWrap="true"/>
                    <Label text="• Background the app and return to it to watch the per-window foreground/background events." class="caption m-l-15" textWrap="true"/>
                </StackLayout>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</Page>
