{
	"compilerOptions": {
		"strict": true,
		"target": "ES2020",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["dom", "ESNext"],
		"noEmitHelpers": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"paths": {
			"~/*": ["./app/*"],
			"@/*": ["./app/*"]
		}
	},
	"include": ["app"],
	"exclude": ["node_modules", "platforms"]
}
